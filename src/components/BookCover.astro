---
import type { Book } from '../lib/library';
const { book, priority = false } = Astro.props as { book: Book; priority?: boolean };
---
<div class="book-cover">
  <div class="cover-fallback" aria-hidden="true">{book.title}<span>{book.author}</span></div>
  {book.cover && <img src={book.cover} alt="" width="240" height="340" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} referrerpolicy="no-referrer" />}
</div>
<script>
  function coverFallback() {
    document.querySelectorAll<HTMLImageElement>('.book-cover img').forEach((image) => {
      const hide = () => { image.hidden = true; };
      if (image.complete && !image.naturalWidth) hide();
      image.addEventListener('error', hide, { once: true });
    });
  }
  coverFallback();
</script>
